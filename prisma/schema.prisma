// Esquema de datos de la app de Permisos Sanitarios de Importación (VUCEM 260211).
//
// Convenciones:
// - SQLite en desarrollo; los "enums" se guardan como String y se validan en código
//   (ver src/lib/constantes.ts) para que el esquema sea portable a PostgreSQL.
// - Todo dato de negocio cuelga de una Empresa (multi-RFC). Las consultas SIEMPRE filtran
//   por empresaId (ver src/lib/auth/contexto.ts).
// - Los nombres de campo siguen el Manual WS 260211 (SAT-AGCTI v1.0) cuando aplica.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────────── Usuarios y sesiones ─────────────────────────────

model Usuario {
  id            String      @id @default(cuid())
  email         String      @unique
  nombre        String
  passwordHash  String
  activo        Boolean     @default(true)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
  sesiones      Sesion[]
  membresias    Membresia[]
}

model Sesion {
  id              String   @id @default(cuid())
  /// SHA-256 del token de la cookie (el token en claro nunca se guarda).
  tokenHash       String   @unique
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaActivaId String?
  expiraEn        DateTime
  creadoEn        DateTime @default(now())

  @@index([usuarioId])
}

/// Empresa importadora (solicitante ante VUCEM). Una agencia puede tener varias.
model Empresa {
  id                String    @id @default(cuid())
  rfc               String    @unique
  /// "MORAL" | "FISICA" (WS: tipoPersonaSolicitante 1 = moral, 0 = física)
  tipoPersona       String    @default("MORAL")
  razonSocial       String?
  nombre            String?
  apellidoPaterno   String?
  apellidoMaterno   String?
  curp              String?
  actividadProductiva String?
  correoElectronico String
  telefono          String?
  // Domicilio fiscal tal como está registrado en VUCEM (forma parte de la cadena original).
  calle             String?
  numeroExterior    String?
  numeroInterior    String?
  codigoPostal      String?
  colonia           String?
  localidad         String?
  municipio         String?
  entidadFederativa String?
  pais              String    @default("MEX")
  creadoEn          DateTime  @default(now())
  actualizadoEn     DateTime  @updatedAt

  membresias        Membresia[]
  establecimientos  Establecimiento[]
  terceros          Tercero[]
  productos         Producto[]
  documentos        Documento[]
  solicitudes       Solicitud[]
  credencialVucem   CredencialVucem?
  configuracionVucem ConfiguracionVucem?
  bitacora          Bitacora[]

  // ERP: arquitectura empresarial (compras, almacén, ventas, cobranza, finanzas, gobierno)
  configuracionErp  ConfiguracionErp?
  almacenes         Almacen[]
  articulos         Articulo[]
  proveedores       Proveedor[]
  clientes          Cliente[]
  ordenesCompra     OrdenCompra[]
  recepciones       Recepcion[]
  pedidosVenta      PedidoVenta[]
  cuentasPorPagar   CuentaPorPagar[]
  cuentasPorCobrar  CuentaPorCobrar[]
  movimientosTesoreria MovimientoTesoreria[]
  controlesGobierno ControlGobierno[]
  riesgos           RiesgoSeguridad[]
  tickets           TicketServicio[]
}

model Membresia {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "ADMIN" | "CAPTURISTA" | "CONSULTA"
  rol       String   @default("CAPTURISTA")
  /// Áreas funcionales del ERP separadas por coma (COMPRAS,ALMACEN,VENTAS,COBRANZA,FINANZAS,
  /// APROBADOR,GOBIERNO). null = todas las áreas operativas (sin APROBADOR ni GOBIERNO).
  /// Base de la segregación de funciones (ISO/IEC 27001 A.5.3, COBIT DSS06).
  areas     String?
  creadoEn  DateTime @default(now())

  @@unique([usuarioId, empresaId])
}

// ───────────────────────────── VUCEM: credenciales y configuración ─────────────

/// Contraseña de servicios web de VUCEM, cifrada con AES-256-GCM (APP_ENCRYPTION_KEY).
/// La e.firma (.cer/.key) NUNCA se guarda: se usa solo en el navegador.
model CredencialVucem {
  id                String   @id @default(cuid())
  empresaId         String   @unique
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Usuario del UsernameToken (normalmente el RFC del solicitante).
  usuarioWs         String
  passwordCifrado   String
  actualizadoEn     DateTime @updatedAt
  actualizadoPorId  String?
}

model ConfiguracionVucem {
  id                     String   @id @default(cuid())
  empresaId              String   @unique
  empresa                Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "SIMULADOR" | "PRUEBAS" | "PRODUCCION"
  ambiente               String   @default("SIMULADOR")
  /// Endpoint SOAP del WS 260211 (no publicado en el manual; se obtiene del WSDL).
  urlSolicitud           String?
  /// Nombre del elemento de operación dentro del Body (manual: "nombreDelServicio").
  operacionSolicitud     String?
  /// Namespace del prefijo ws: del manual.
  namespaceSolicitud     String?
  /// Valor de wsa:Action / SOAPAction.
  soapActionSolicitud    String?
  /// Endpoint del WS de Digitalización (eDocument).
  urlDigitalizacion      String?
  /// Correo que se envía en la digitalización y que forma parte de su cadena original.
  correoDigitalizacion   String?
  actualizadoEn          DateTime @updatedAt
}

// ───────────────────────────── Catálogos ─────────────────────────────

/// Catálogos de VUCEM / SAT (globales). catalogo = CAT_ADUANA, CAT_REGIMEN, CAT_PAIS, ...
model CatalogoVucem {
  id          String  @id @default(cuid())
  catalogo    String
  clave       String
  descripcion String
  /// Para catálogos jerárquicos (p. ej. subclasificación → clasificación).
  padreClave  String?
  /// "SEMILLA" | "IMPORTADO" | "MANUAL"
  fuente      String  @default("SEMILLA")
  /// true cuando la clave no se ha verificado contra el catálogo oficial.
  porConfirmar Boolean @default(false)
  activo      Boolean @default(true)

  @@unique([catalogo, clave])
  @@index([catalogo])
}

model DiaInhabil {
  id          String   @id @default(cuid())
  fecha       DateTime @unique
  descripcion String
}

/// Definición versionada del trámite (campos/requisitos/límites pueden cambiar por normativa).
model TramiteVersion {
  id            String      @id @default(cuid())
  claveVucem    String      // "260211"
  homoclave     String?     // p. ej. "COFEPRIS-01-014-A"
  nombre        String
  /// "VUCEM_CLASICA" | "VUCEM_3"
  plataforma    String
  vigenteDesde  DateTime
  activo        Boolean     @default(true)
  /// JSON: { requisitos: [{ tipo, nombre, obligatorio, maxMB, minDpi }], notas }
  definicion    String
  creadoEn      DateTime    @default(now())
  solicitudes   Solicitud[]

  @@unique([claveVucem, vigenteDesde])
}

// ───────────────────────────── Catálogos de la empresa ─────────────────────────

model Establecimiento {
  id                       String   @id @default(cuid())
  empresaId                String
  empresa                  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  denominacionRazonSocial  String
  rfcResponsableSanitario  String
  correoElectronico        String
  telefono                 String
  calle                    String
  numeroExterior           String?
  codigoPostal             String
  /// Clave/descripción de CAT_ENTIDAD
  entidadFederativa        String
  municipio                String
  colonia                  String?
  localidad                String?
  noLicenciaSanitaria      String?
  /// WS avisoFuncionamiento (0/1). Excluyente con licencia sanitaria en el portal.
  tieneAvisoFuncionamiento Boolean  @default(false)
  activo                   Boolean  @default(true)
  creadoEn                 DateTime @default(now())
  actualizadoEn            DateTime @updatedAt
  scian                    EstablecimientoScian[]
  solicitudes              Solicitud[]
  documentos               Documento[]

  @@index([empresaId])
}

model EstablecimientoScian {
  id                String          @id @default(cuid())
  establecimientoId String
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id], onDelete: Cascade)
  /// Clave SCIAN de 6 dígitos
  clave             String
  descripcion       String?

  @@unique([establecimientoId, clave])
}

/// Terceros: fabricantes, proveedores, destinatarios y facturadores.
model Tercero {
  id                      String   @id @default(cuid())
  empresaId               String
  empresa                 Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "FABRICANTE" | "PROVEEDOR" | "DESTINATARIO" | "FACTURADOR"
  tipo                    String
  /// "FISICA" | "MORAL"
  tipoPersona             String
  /// "NACIONAL" | "EXTRANJERO"
  nacionalidad            String   @default("EXTRANJERO")
  nombre                  String?
  apellidoPaterno         String?
  apellidoMaterno         String?
  denominacionRazonSocial String?
  rfc                     String?
  curp                    String?
  correoElectronico       String?
  /// Clave de país de 3 letras (CAT_PAIS)
  pais                    String
  entidadFederativa       String?
  municipio               String?
  colonia                 String?
  localidad               String?
  codigoPostal            String?
  calle                   String
  numeroExterior          String?
  numeroInterior          String?
  lada                    String?
  telefono                String?
  activo                  Boolean  @default(true)
  creadoEn                DateTime @default(now())
  actualizadoEn           DateTime @updatedAt
  productosFabricados     Producto[]
  solicitudes             SolicitudTercero[]

  @@index([empresaId, tipo])
}

/// Dispositivo médico (mercancía) reutilizable entre solicitudes.
model Producto {
  id                          String    @id @default(cuid())
  empresaId                   String
  empresa                     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  denominacionEspecifica      String
  /// Marca
  denominacionDistintiva      String
  denominacionComunCientifica String
  idClasificacionProducto     String?
  idSubClasificacionProducto  String?
  idTipoProducto              String?
  especifique                 String?
  idFormaFarmaceutica         String?
  idEstadoFisico              String?
  /// Fracción arancelaria TIGIE de 8 dígitos
  fraccionArancelaria         String
  descripcionFraccion         String?
  /// Clave de unidad de medida tarifaria
  umt                         String?
  /// Clave de unidad de medida comercial (CAT_UNIDAD_MEDIDA)
  umc                         String?
  /// Descripción de la UMC (WS desUMC)
  desUMC                      String
  presentacionTipoEnvase      String
  numRegistroSanitario        String?
  vigenciaRegistroSanitario   DateTime?
  cvePaisOrigen               String?
  idUsoEspecifico             String?
  fabricanteId                String?
  fabricante                  Tercero?  @relation(fields: [fabricanteId], references: [id], onDelete: SetNull)
  notas                       String?
  activo                      Boolean   @default(true)
  creadoEn                    DateTime  @default(now())
  actualizadoEn               DateTime  @updatedAt
  partidas                    PartidaSolicitud[]
  documentos                  Documento[]

  @@index([empresaId])
}

// ───────────────────────────── Documentos ─────────────────────────────

model Documento {
  id                      String    @id @default(cuid())
  empresaId               String
  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Tipo de requisito (ver TIPOS_DOCUMENTO en src/lib/constantes.ts)
  tipo                    String
  /// Nombre descriptivo (también es "nombreDocumento" en la digitalización VUCEM)
  nombre                  String
  /// idTipoDocumento del catálogo de digitalización VUCEM (CAT_TIPO_DOCUMENTO)
  idTipoDocumentoVucem    String?
  productoId              String?
  producto                Producto?        @relation(fields: [productoId], references: [id], onDelete: SetNull)
  establecimientoId       String?
  establecimiento         Establecimiento? @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)
  vigenciaHasta           DateTime?
  // Archivo original (ruta relativa dentro de STORAGE_DIR)
  archivoOriginalRuta     String
  archivoOriginalNombre   String
  archivoOriginalBytes    Int
  archivoOriginalMime     String
  // Archivo convertido al formato VUCEM (PDF solo-imagen, escala de grises, >= 300 dpi)
  archivoVucemRuta        String?
  archivoVucemBytes       Int?
  sha1Vucem               String?
  paginas                 Int?
  dpi                     Int?
  /// "PENDIENTE" | "OK" | "ADVERTENCIA" | "ERROR"
  estadoConversion        String    @default("PENDIENTE")
  /// JSON con el reporte de conversión (páginas en blanco, tamaño, avisos)
  reporteConversion       String?
  // Digitalización VUCEM (eDocument)
  /// "NO_ENVIADO" | "PENDIENTE" | "OK" | "ERROR"
  estadoEDocument         String    @default("NO_ENVIADO")
  numeroOperacionEDoc     String?
  eDocument               String?
  numeroTramiteEDoc       String?
  errorEDocument          String?
  eDocumentFecha          DateTime?
  creadoEn                DateTime  @default(now())
  creadoPorId             String?
  actualizadoEn           DateTime  @updatedAt
  solicitudes             SolicitudDocumento[]
  envios                  EnvioVucem[]

  @@index([empresaId, tipo])
}

// ───────────────────────────── Solicitudes ─────────────────────────────

model Solicitud {
  id                     String          @id @default(cuid())
  /// Consecutivo legible para el usuario (por empresa)
  numero                 Int
  empresaId              String
  empresa                Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tramiteVersionId       String
  tramiteVersion         TramiteVersion  @relation(fields: [tramiteVersionId], references: [id])
  establecimientoId      String?
  establecimiento        Establecimiento? @relation(fields: [establecimientoId], references: [id], onDelete: SetNull)
  /// Ver ESTADOS_SOLICITUD en src/lib/constantes.ts
  estado                 String          @default("BORRADOR")
  cveRegimen             String?
  cveAduana              String?
  // Manifiestos y declaraciones
  cveDeclaracion         Boolean         @default(false)
  informacionConfidencial Boolean        @default(false)
  // Representante legal
  rlRfc                  String?
  rlNombre               String?
  rlApellidoPaterno      String?
  rlApellidoMaterno      String?
  // Pago de derechos (e5cinco)
  pagoOmitido            Boolean         @default(false)
  claveReferencia        String?
  cadenaDependencia      String?
  cveBanco               String?
  llavePago              String?
  fechaPago              DateTime?
  /// Importe en pesos con 2 decimales, guardado como texto ("3117.00") para no perder precisión.
  importePago            String?
  // Presentación
  /// "WS" | "PORTAL"
  canalPresentacion      String?
  numeroTemporal         String?
  /// Folio oficial VUCEM de 25 dígitos
  folioVucem             String?
  fechaPresentacion      DateTime?
  acuseRuta              String?
  notas                  String?
  creadoPorId            String?
  creadoEn               DateTime        @default(now())
  actualizadoEn          DateTime        @updatedAt
  partidas               PartidaSolicitud[]
  terceros               SolicitudTercero[]
  documentos             SolicitudDocumento[]
  requerimientos         Requerimiento[]
  resolucion             Resolucion?
  envios                 EnvioVucem[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

/// Mercancía de la solicitud. Se copian los datos del producto (snapshot) para que
/// editar el catálogo no altere solicitudes ya presentadas.
model PartidaSolicitud {
  id                          String    @id @default(cuid())
  solicitudId                 String
  solicitud                   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoId                  String?
  producto                    Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  orden                       Int
  idClasificacionProducto     String?
  idSubClasificacionProducto  String?
  denominacionEspecifica      String
  denominacionDistintiva      String
  denominacionComunCientifica String
  idTipoProducto              String?
  especifique                 String?
  idFormaFarmaceutica         String?
  idEstadoFisico              String?
  fraccionArancelaria         String
  descripcionFraccion         String?
  /// Cantidades con hasta 3 decimales guardadas como texto
  cantidadUMT                 String
  cantidadUMC                 String
  umt                         String?
  umc                         String?
  desUMC                      String
  presentacionTipoEnvase      String
  numRegistroSanitario        String?
  /// dd/mm/aa según el manual; se guarda como fecha
  fechaCaducidad              DateTime?
  cvePaisOrigen               String
  cvePaisProcedencia          String
  idUsoEspecifico             String?
  /// Resultado en la resolución: "ACEPTADA" | "RECHAZADA"
  resultado                   String?

  @@index([solicitudId])
}

model SolicitudTercero {
  id          String    @id @default(cuid())
  solicitudId String
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  terceroId   String
  tercero     Tercero   @relation(fields: [terceroId], references: [id], onDelete: Restrict)
  /// Rol en esta solicitud: "FABRICANTE" | "PROVEEDOR" | "DESTINATARIO" | "FACTURADOR"
  rol         String

  @@unique([solicitudId, terceroId, rol])
}

model SolicitudDocumento {
  id          String    @id @default(cuid())
  solicitudId String
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  /// Tipo de requisito que cubre este documento
  requisito   String

  @@unique([solicitudId, documentoId])
}

model Requerimiento {
  id                String    @id @default(cuid())
  solicitudId       String
  solicitud         Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  fechaNotificacion DateTime
  plazoDiasHabiles  Int
  fechaLimite       DateTime
  descripcion       String
  /// "PENDIENTE" | "ATENDIDO"
  estado            String    @default("PENDIENTE")
  fechaAtencion     DateTime?
  notas             String?
  creadoEn          DateTime  @default(now())
}

model Resolucion {
  id              String    @id @default(cuid())
  solicitudId     String    @unique
  solicitud       Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  /// "ACEPTADA" | "RECHAZADA" | "PARCIAL"
  sentido         String
  numeroPermiso   String?
  fechaResolucion DateTime
  vigenciaHasta   DateTime?
  restricciones   String?
  observaciones   String?
  documentoRuta   String?
  creadoEn        DateTime  @default(now())
}

/// Bitácora de cada intercambio con VUCEM (XML sin contraseñas).
model EnvioVucem {
  id           String     @id @default(cuid())
  empresaId    String
  solicitudId  String?
  solicitud    Solicitud? @relation(fields: [solicitudId], references: [id], onDelete: SetNull)
  documentoId  String?
  documento    Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  /// "SOLICITUD_260211" | "DIGITALIZACION_REGISTRO" | "DIGITALIZACION_CONSULTA"
  tipo         String
  ambiente     String
  url          String
  cadenaOriginal String?
  requestXml   String
  responseXml  String?
  httpStatus   Int?
  exito        Boolean    @default(false)
  mensaje      String?
  /// Folio / numeroOperacion / eDocument devuelto
  resultado    String?
  creadoEn     DateTime   @default(now())
  creadoPorId  String?

  @@index([empresaId, creadoEn])
}

model Bitacora {
  id        String   @id @default(cuid())
  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId String?
  accion    String
  entidad   String
  entidadId String?
  /// JSON con detalles (nunca contraseñas ni llaves)
  detalle   String?
  creadoEn  DateTime @default(now())

  @@index([empresaId, creadoEn])
}

// ═════════════════════════════ ERP · Arquitectura empresarial ═════════════════════════════
//
// Convenciones del ERP (ver docs/arquitectura-empresarial.md):
// - Importes en CENTAVOS (Int) para no perder precisión; cantidades en Float redondeadas a 3
//   decimales (src/lib/erp/dinero.ts).
// - Tasas en puntos base (1600 = 16 %).
// - Todo documento lleva consecutivo por empresa (numero) y quién lo creó/aprobó (trazabilidad,
//   ISO/IEC 27001 A.8.15) y cada cambio queda en Bitacora.

/// Políticas de decisión de la empresa (COBIT APO01/EDM03): umbrales de aprobación, tolerancias
/// y parámetros de crédito y cobranza. Una por empresa; se crea con valores por defecto.
model ConfiguracionErp {
  id                         String   @id @default(cuid())
  empresaId                  String   @unique
  empresa                    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// OC con total <= este importe (centavos) se aprueban automáticamente (nivel 0).
  montoAutoAprobacion        Int      @default(500000)
  /// OC con total <= este importe requieren 1 aprobador (APROBADOR o ADMIN).
  montoAprobacionNivel1      Int      @default(5000000)
  // Arriba de nivel 1 se requiere aprobación de un ADMIN (nivel 2, dirección).
  /// Tolerancia de la conciliación a tres vías (OC-recepción-factura) en puntos base.
  toleranciaPrecioBp         Int      @default(200)
  toleranciaCantidadBp       Int      @default(0)
  /// Crédito a clientes
  diasGraciaCredito          Int      @default(15)
  puntajeCreditoMinimo       Int      @default(60)
  puntajeCreditoRevision     Int      @default(40)
  /// Nivel de servicio objetivo para el stock de seguridad (factor z: 165 = 1.65 → 95 %).
  factorServicioZ            Int      @default(165)
  /// Separación estricta de funciones (si false, solo se advierte).
  segregacionEstricta        Boolean  @default(true)
  tasaIvaBp                  Int      @default(1600)
  actualizadoEn              DateTime @updatedAt
}

model Almacen {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clave        String
  nombre       String
  ubicacion    String?
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
  existencias  Existencia[]
  movimientos  MovimientoInventario[]
  ordenesCompra OrdenCompra[]
  recepciones  Recepcion[]
  pedidosVenta PedidoVenta[]

  @@unique([empresaId, clave])
}

/// Artículo de inventario (SKU). Puede ligarse a un Producto del catálogo COFEPRIS.
model Articulo {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sku                  String
  nombre               String
  categoria            String?
  unidad               String   @default("PZA")
  /// Precio de venta de lista (centavos, sin IVA)
  precioVenta          Int      @default(0)
  /// Último costo de compra (centavos)
  ultimoCosto          Int      @default(0)
  tasaIvaBp            Int      @default(1600)
  // Parámetros del modelo de inventario (EOQ / punto de reorden)
  stockMinimo          Float    @default(0)
  stockMaximo          Float    @default(0)
  /// Demanda anual estimada (unidades). Si es 0 se estima con las salidas de los últimos 365 días.
  demandaAnual         Float    @default(0)
  /// Costo de ordenar por pedido (centavos)
  costoOrdenar         Int      @default(50000)
  /// Costo anual de mantener inventario como % del costo (puntos base, 2500 = 25 %)
  costoMantenerBp      Int      @default(2500)
  tiempoEntregaDias    Int      @default(7)
  /// Desviación estándar de la demanda diaria (unidades) para el stock de seguridad.
  desviacionDemandaDiaria Float @default(0)
  proveedorPreferenteId String?
  proveedorPreferente  Proveedor? @relation(fields: [proveedorPreferenteId], references: [id], onDelete: SetNull)
  productoId           String?
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now())
  actualizadoEn        DateTime @updatedAt
  existencias          Existencia[]
  movimientos          MovimientoInventario[]
  partidasCompra       PartidaOrdenCompra[]
  partidasVenta        PartidaVenta[]

  @@unique([empresaId, sku])
  @@index([empresaId])
}

/// Existencia por artículo y almacén con costo promedio ponderado.
model Existencia {
  id             String   @id @default(cuid())
  articuloId     String
  articulo       Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  almacenId      String
  almacen        Almacen  @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  cantidad       Float    @default(0)
  /// Costo promedio ponderado (centavos por unidad)
  costoPromedio  Int      @default(0)
  actualizadoEn  DateTime @updatedAt

  @@unique([articuloId, almacenId])
}

/// Kárdex: cada entrada/salida de inventario (inmutable; las correcciones son ajustes).
model MovimientoInventario {
  id             String   @id @default(cuid())
  empresaId      String
  articuloId     String
  articulo       Articulo @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  almacenId      String
  almacen        Almacen  @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  /// "ENTRADA_COMPRA" | "SALIDA_VENTA" | "AJUSTE_ENTRADA" | "AJUSTE_SALIDA" | "INVENTARIO_INICIAL"
  tipo           String
  /// Positiva en entradas, negativa en salidas
  cantidad       Float
  costoUnitario  Int
  /// Existencia y costo promedio resultantes
  saldoCantidad  Float
  saldoCostoPromedio Int
  /// "RECEPCION" | "PEDIDO_VENTA" | "AJUSTE"
  referenciaTipo String?
  referenciaId   String?
  motivo         String?
  creadoPorId    String?
  creadoEn       DateTime @default(now())

  @@index([empresaId, creadoEn])
  @@index([articuloId, creadoEn])
}

model Proveedor {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clave            String
  rfc              String?
  razonSocial      String
  contacto         String?
  correoElectronico String?
  telefono         String?
  diasCredito      Int      @default(30)
  /// "CRITICO" | "ESTRATEGICO" | "NORMAL" (criticidad para priorizar pagos y riesgos de terceros)
  criticidad       String   @default("NORMAL")
  /// Ligado opcional al tercero del catálogo COFEPRIS/VUCEM (mismo proveedor, una sola fuente).
  terceroId        String?
  /// "ACTIVO" | "EN_EVALUACION" | "BLOQUEADO"
  estado           String   @default("ACTIVO")
  notas            String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  ordenesCompra    OrdenCompra[]
  cuentasPorPagar  CuentaPorPagar[]
  articulos        Articulo[]

  @@unique([empresaId, clave])
}

model OrdenCompra {
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            Int
  proveedorId       String
  proveedor         Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  almacenId         String
  almacen           Almacen  @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  /// "BORRADOR" | "POR_APROBAR" | "APROBADA" | "RECIBIDA_PARCIAL" | "RECIBIDA" | "RECHAZADA" | "CANCELADA"
  estado            String   @default("BORRADOR")
  fechaEntrega      DateTime?
  subtotal          Int      @default(0)
  iva               Int      @default(0)
  total             Int      @default(0)
  /// Nivel de aprobación requerido (0 = automática, 1 = aprobador, 2 = dirección)
  nivelAprobacion   Int      @default(0)
  creadoPorId       String?
  enviadaEn         DateTime?
  aprobadoPorId     String?
  aprobadoEn        DateTime?
  motivoRechazo     String?
  notas             String?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt
  partidas          PartidaOrdenCompra[]
  recepciones       Recepcion[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model PartidaOrdenCompra {
  id               String   @id @default(cuid())
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  articuloId       String
  articulo         Articulo @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad         Float
  cantidadRecibida Float    @default(0)
  costoUnitario    Int
  tasaIvaBp        Int      @default(1600)
  partidasRecepcion PartidaRecepcion[]

  @@index([ordenCompraId])
}

/// Recepción de mercancía contra una OC: genera entradas al kárdex y la cuenta por pagar.
model Recepcion {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero           Int
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Restrict)
  almacenId        String
  almacen          Almacen  @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  fecha            DateTime @default(now())
  /// Factura del proveedor (UUID/folio CFDI) y su importe, para la conciliación a tres vías
  folioFactura     String?
  importeFactura   Int?
  /// Resultado de la conciliación: "OK" | "DIFERENCIA_PRECIO" | "DIFERENCIA_CANTIDAD" | "SIN_FACTURA"
  conciliacion     String   @default("SIN_FACTURA")
  aTiempo          Boolean  @default(true)
  recibidoPorId    String?
  notas            String?
  creadoEn         DateTime @default(now())
  partidas         PartidaRecepcion[]
  cuentaPorPagar   CuentaPorPagar?

  @@unique([empresaId, numero])
}

model PartidaRecepcion {
  id                 String   @id @default(cuid())
  recepcionId        String
  recepcion          Recepcion @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  partidaOrdenId     String
  partidaOrden       PartidaOrdenCompra @relation(fields: [partidaOrdenId], references: [id], onDelete: Restrict)
  cantidadRecibida   Float
  cantidadRechazada  Float    @default(0)
  motivoRechazo      String?
}

model CuentaPorPagar {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  proveedorId      String
  proveedor        Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  recepcionId      String?  @unique
  recepcion        Recepcion? @relation(fields: [recepcionId], references: [id], onDelete: SetNull)
  folio            String
  fechaEmision     DateTime
  fechaVencimiento DateTime
  total            Int
  saldo            Int
  /// "PENDIENTE" | "BLOQUEADA" (diferencia en conciliación) | "PARCIAL" | "PAGADA" | "CANCELADA"
  estado           String   @default("PENDIENTE")
  liberadaPorId    String?
  creadoEn         DateTime @default(now())
  pagos            PagoProveedor[]

  @@index([empresaId, estado])
}

model PagoProveedor {
  id               String   @id @default(cuid())
  cuentaPorPagarId String
  cuentaPorPagar   CuentaPorPagar @relation(fields: [cuentaPorPagarId], references: [id], onDelete: Cascade)
  fecha            DateTime
  monto            Int
  /// "TRANSFERENCIA" | "CHEQUE" | "EFECTIVO" | "TARJETA"
  metodo           String
  referencia       String?
  registradoPorId  String?
  creadoEn         DateTime @default(now())
}

model Cliente {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clave            String
  rfc              String?
  razonSocial      String
  contacto         String?
  correoElectronico String?
  telefono         String?
  diasCredito      Int      @default(0)
  /// Límite de crédito (centavos). 0 = solo contado.
  limiteCredito    Int      @default(0)
  /// "ACTIVO" | "SUSPENDIDO" (crédito retenido por cobranza)
  estado           String   @default("ACTIVO")
  notas            String?
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
  pedidos          PedidoVenta[]
  cuentasPorCobrar CuentaPorCobrar[]

  @@unique([empresaId, clave])
}

model PedidoVenta {
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero            Int
  clienteId         String
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  almacenId         String
  almacen           Almacen  @relation(fields: [almacenId], references: [id], onDelete: Restrict)
  /// "BORRADOR" | "POR_AUTORIZAR" (decisión de crédito) | "CONFIRMADO" | "ENTREGADO" | "CANCELADO"
  estado            String   @default("BORRADOR")
  /// "CONTADO" | "CREDITO"
  condicionPago     String   @default("CONTADO")
  subtotal          Int      @default(0)
  iva               Int      @default(0)
  total             Int      @default(0)
  /// Costo de lo vendido al entregar (centavos) para el margen bruto
  costoVenta        Int      @default(0)
  /// Resultado del modelo de crédito: JSON { puntaje, decision, motivos }
  evaluacionCredito String?
  autorizadoPorId   String?
  creadoPorId       String?
  entregadoEn       DateTime?
  notas             String?
  creadoEn          DateTime @default(now())
  actualizadoEn     DateTime @updatedAt
  partidas          PartidaVenta[]
  cuentaPorCobrar   CuentaPorCobrar?

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}

model PartidaVenta {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         PedidoVenta @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  articuloId     String
  articulo       Articulo @relation(fields: [articuloId], references: [id], onDelete: Restrict)
  cantidad       Float
  precioUnitario Int
  descuentoBp    Int      @default(0)
  tasaIvaBp      Int      @default(1600)
  costoUnitario  Int      @default(0)

  @@index([pedidoId])
}

model CuentaPorCobrar {
  id               String   @id @default(cuid())
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedidoId         String?  @unique
  pedido           PedidoVenta? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  folio            String
  fechaEmision     DateTime
  fechaVencimiento DateTime
  total            Int
  saldo            Int
  /// "PENDIENTE" | "PARCIAL" | "PAGADA" | "INCOBRABLE" | "CANCELADA"
  estado           String   @default("PENDIENTE")
  creadoEn         DateTime @default(now())
  cobros           Cobro[]
  gestiones        GestionCobranza[]

  @@index([empresaId, estado])
}

model Cobro {
  id                String   @id @default(cuid())
  cuentaPorCobrarId String
  cuentaPorCobrar   CuentaPorCobrar @relation(fields: [cuentaPorCobrarId], references: [id], onDelete: Cascade)
  fecha             DateTime
  monto             Int
  metodo            String
  referencia        String?
  registradoPorId   String?
  creadoEn          DateTime @default(now())
}

/// Bitácora de gestión de cobranza (llamadas, correos, promesas de pago).
model GestionCobranza {
  id                String   @id @default(cuid())
  cuentaPorCobrarId String
  cuentaPorCobrar   CuentaPorCobrar @relation(fields: [cuentaPorCobrarId], references: [id], onDelete: Cascade)
  /// "RECORDATORIO" | "LLAMADA" | "CORREO" | "VISITA" | "PROMESA_PAGO" | "SUSPENSION" | "JURIDICO"
  tipo              String
  nota              String
  fechaPromesa      DateTime?
  registradoPorId   String?
  creadoEn          DateTime @default(now())
}

/// Tesorería: ingresos y egresos (cobros y pagos se registran automáticamente).
model MovimientoTesoreria {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "INGRESO" | "EGRESO"
  tipo           String
  /// "COBRO_CLIENTE" | "PAGO_PROVEEDOR" | "NOMINA" | "IMPUESTOS" | "SERVICIOS" | "OTRO"
  categoria      String
  monto          Int
  fecha          DateTime
  concepto       String
  referenciaTipo String?
  referenciaId   String?
  registradoPorId String?
  creadoEn       DateTime @default(now())

  @@index([empresaId, fecha])
}

/// Control de gobierno: objetivo COBIT 2019 (nivel de capacidad) o control del Anexo A de
/// ISO/IEC 27001:2022 (declaración de aplicabilidad).
model ControlGobierno {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "COBIT" | "ISO27001"
  marco          String
  clave          String
  nombre         String
  dominio        String
  /// Proceso del ERP que lo implementa (COMPRAS, ALMACEN, ...)
  procesoErp     String?
  aplicable      Boolean  @default(true)
  justificacion  String?
  /// COBIT: nivel de capacidad 0-5. ISO: 0 = no implementado … 5 = optimizado.
  nivelActual    Int      @default(0)
  nivelObjetivo  Int      @default(3)
  responsable    String?
  evidencia      String?
  revisadoEn     DateTime?
  actualizadoEn  DateTime @updatedAt

  @@unique([empresaId, marco, clave])
}

/// Registro de riesgos de seguridad de la información (ISO/IEC 27001 cláusula 6.1.2).
model RiesgoSeguridad {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero         Int
  activo         String
  amenaza        String
  vulnerabilidad String
  probabilidad   Int
  impacto        Int
  /// "MITIGAR" | "ACEPTAR" | "TRANSFERIR" | "EVITAR"
  tratamiento    String   @default("MITIGAR")
  controles      String?
  responsable    String?
  probabilidadResidual Int?
  impactoResidual      Int?
  /// "ABIERTO" | "EN_TRATAMIENTO" | "CERRADO"
  estado         String   @default("ABIERTO")
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@unique([empresaId, numero])
}

/// Gestión de servicios ITIL 4: incidentes, problemas, solicitudes y cambios.
model TicketServicio {
  id             String   @id @default(cuid())
  empresaId      String
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero         Int
  /// "INCIDENTE" | "PROBLEMA" | "SOLICITUD" | "CAMBIO"
  tipo           String
  /// Servicio de negocio afectado (COMPRAS, ALMACEN, VENTAS, COBRANZA, FINANZAS, TI)
  servicio       String
  titulo         String
  descripcion    String
  impacto        Int
  urgencia       Int
  /// Prioridad ITIL 1 (crítica) … 5 (planificación)
  prioridad      Int
  /// Cambios: "ESTANDAR" | "NORMAL" | "EMERGENCIA"
  tipoCambio     String?
  /// "NUEVO" | "EN_PROCESO" | "PENDIENTE_APROBACION" | "APROBADO" | "RESUELTO" | "CERRADO" | "RECHAZADO"
  estado         String   @default("NUEVO")
  venceEn        DateTime
  resueltoEn     DateTime?
  solucion       String?
  reportadoPorId String?
  aprobadoPorId  String?
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
}
