# Base de datos (SQLite en desarrollo). En producción puede ser PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"

# Llave de 32 bytes en base64 para cifrar la contraseña de servicios web de VUCEM.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Carpeta privada donde se guardan los PDFs (no debe ser pública).
STORAGE_DIR="./storage"

# URL pública de la app (se usa para el simulador de VUCEM en desarrollo).
APP_URL="http://localhost:3000"
